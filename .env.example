# Optional: replace the shared browser key with your own TMDB v3 API key.
TMDB_API_KEY=

# External watch site. The default is shown here for clarity.
MOVIE_SITE_BASE=https://67movies.net

# Used to enrich sparse searches and as a fallback when TMDB is unavailable.
SEARCH_FALLBACK_URL=https://67movies.net/api/semantic-search

# Optional owner panel. Leave all three blank to disable it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_USER_IDS=

# Optional server restart controls.
RENDER_API_KEY=
RENDER_SERVICE_ID=
RESTART_WEBHOOK_URL=
RESTART_WEBHOOK_METHOD=POST
RESTART_WEBHOOK_TOKEN=

# Optional cache tuning.
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=500
SETTINGS_CACHE_TTL_SECONDS=15
